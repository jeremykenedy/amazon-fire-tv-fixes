{
  "name": "amazon-fire-tv-fixes",
  "version": "2.0.0",
  "description": "Fix Alexa deep-sleep disconnects and remove ad screensavers on Fire TV Edition, over adb.",
  "license": "MIT",
  "author": "Jeremy Kenedy",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --test-timeout=90000 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info"
  },
  "bin": {
    "amazon-fire-tv-fixes": "./bin/amazon-fire-tv-fixes.js",
    "amazon-fire-tv-fixes-uninstall": "./bin/amazon-fire-tv-fixes-uninstall.js",
    "enable-alexa-fix": "./bin/enable-alexa-fix.js",
    "disable-alexa-fix": "./bin/disable-alexa-fix.js",
    "firetv-install-adb": "./bin/firetv-install-adb.js",
    "firetv-screensavers": "./bin/firetv-screensavers.js",
    "firetv-set-screensaver": "./bin/firetv-set-screensaver.js",
    "firetv-timeouts": "./bin/firetv-timeouts.js",
    "firetv-timeout-sleep": "./bin/firetv-timeout-sleep.js",
    "firetv-timeout-screensaver": "./bin/firetv-timeout-screensaver.js",
    "firetv-timeouts-reset": "./bin/firetv-timeouts-reset.js",
    "firetv-timeouts-possible": "./bin/firetv-timeouts-possible.js",
    "firetv-timeouts-current": "./bin/firetv-timeouts-current.js",
    "info": "./bin/info.js",
    "information": "./bin/information.js",
    "guide": "./bin/guide.js",
    "start": "./bin/start.js",
    "update": "./bin/update.js",
    "firetv": "./bin/firetv.js",
    "uninstall": "./bin/uninstall.js",
    "delete": "./bin/delete.js",
    "remove": "./bin/remove.js"
  },
  "files": [
    "bin",
    "src",
    "art",
    "setup.js",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fire-tv",
    "amazon-fire-tv",
    "alexa",
    "adb",
    "screensaver",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremykenedy/amazon-fire-tv-fixes.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "figlet": "^1.8.0",
    "ora": "^8.1.1"
  }
}
